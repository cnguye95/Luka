{
  "name": "luka",
  "version": "0.1.0",
  "description": "Obsidian plugin that compiles dropped source documents into a linked markdown wiki with graph-based retrieval.",
  "private": true,
  "license": "Apache-2.0",
  "author": "cnguye95",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cnguye95/Luka.git"
  },
  "bugs": {
    "url": "https://github.com/cnguye95/Luka/issues"
  },
  "homepage": "https://github.com/cnguye95/Luka#readme",
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "knowledge-base",
    "wiki",
    "graph-retrieval",
    "personalized-pagerank",
    "citations",
    "llm"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:boundary": "node scripts/check-boundary.mjs",
    "lint": "eslint src scripts tests eval",
    "install:vault": "node scripts/install-vault.mjs",
    "eval:fixture": "esbuild eval/build-fixture.ts --bundle --packages=external --platform=node --format=esm --outfile=.eval-cache/build-fixture.mjs && node .eval-cache/build-fixture.mjs",
    "eval": "esbuild eval/run.ts --bundle --packages=external --platform=node --format=esm --outfile=.eval-cache/run.mjs && node .eval-cache/run.mjs",
    "eval:live": "esbuild eval/run.ts --bundle --packages=external --platform=node --format=esm --outfile=.eval-cache/run.mjs && node .eval-cache/run.mjs -- --live"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "js-yaml": "^5.3.0",
    "turndown": "^7.2.4",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.2.0",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "obsidian": "^1.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
